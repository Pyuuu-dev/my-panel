# Copy this file to /opt/services/.env and fill in real values.
#   cp .env.example .env && chmod 600 .env
#
# The real .env is git-ignored and must never be committed.

# JWT signing key for panel login sessions.
# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates all active sessions (everyone logs in again).
SECRET_KEY=

# Supervisor XML-RPC endpoint, including credentials.
# Format: http://<user>:<password>@127.0.0.1:9001/RPC2
SUPERVISOR_URL=

# Discord webhook used by the scrapers for notifications.
DISCORD_WEBHOOK_URL=
